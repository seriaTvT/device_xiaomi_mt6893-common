allow hal_vibrator_default input_device:dir r_dir_perms;
allow hal_vibrator_default input_device:chr_file rw_file_perms;

# The (QTI-derived) vibrator HAL probes /sys/devices/soc0 for soc info at
# startup; the path is meaningless on MTK and the HAL works without it.
dontaudit hal_vibrator_default sysfs_soc:dir search;
