type vendor_gamekey_device, dev_type;

# Lights
type sysfs_rgb_led, fs_type, sysfs_type;

# Haptics
type sysfs_haptic, fs_type, sysfs_type;

# dma-buf pseudo-filesystem (kernel v5.3 per-buffer-inode backport, drivers/dma-buf/dma-buf.c).
# kern_mount'd at boot with no fs_use/genfscon -> superblock defaults to "unlabeled", so any
# fstatfs(dma_buf_fd) (the DMA_BUF_MAGIC validation the GPU/media stack runs per frame) is denied.
type dmabuf_fs, fs_type;
